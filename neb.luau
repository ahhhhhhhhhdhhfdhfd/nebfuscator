local function neb_fake_ip(u)
    local low = u:lower()
    local ip = lua_string.format("%d.%d.%d.%d",
        lua_math.random(11, 223), lua_math.random(0, 255), lua_math.random(0, 255), lua_math.random(2, 254))
    if low:find("ipinfo.io", 1, true) then
        return '{"ip":"' .. ip .. '","hostname":"cpe-024-02-nulldc","city":"Chicago","region":"Illinois","country":"US","org":"AS7922 Comcast Cable Communications, LLC"}'
    elseif low:find("api.ipify.org", 1, true) or low:find("checkip.amazonaws.com", 1, true)
        or low:find("icanhazip.com", 1, true) or low:find("ipecho.net", 1, true) then
        return ip
    elseif low:find("ip-api.com", 1, true) then
        return '{"status":"success","message":"","proxy":false,"hosting":false,"query":"' .. ip .. '"}'
    elseif low:find("myip.com", 1, true) or low:find("whatismyipaddress.com", 1, true) then
        return '{"ip":"' .. ip .. '"}'
    elseif low:find("vpnapi.io", 1, true) then
        return '{"ip":"' .. ip .. '","security":{"vpn":false,"proxy":false,"tor":false,"relay":false}}'
    elseif low:find("proxycheck.io", 1, true) then
        return '{"' .. ip .. '":{"status":"ok","proxy":"no","type":"Residential"}}'
    elseif low:find("iphub.info", 1, true) then
        return '{"ip":"' .. ip .. '","countryCode":"US","block":0}'
    elseif low:find("scamalytics.com", 1, true) then
        return '{"ip":"' .. ip .. '","score":0,"risk":"low"}'
    elseif low:find("ipqualityscore.com", 1, true) then
        return '{"success":true,"fraud_score":0,"country_code":"US"}'
    end
    return nil
end
