        local function runtime_make_connection(sig, fn, once)
            local realfn = (lua_type(fn) == "function") and fn or function() end
            local cstate = {
                Connected = true,
                Enabled = true,
                ForeignState = false,
                LuaConnection = true,
                Function = realfn,
                Thread = coroutine.create(realfn),
            }
            local conn = lua_newproxy(true)
            local cmt = lua_getmetatable(conn)
            cmt.__type = "RBXScriptConnection"
            cmt.__tostring = function() return "Connection" end
            local dis = mark_c(function(self)
                if self == nil then
                    lua_error("invalid argument #1 to 'Disconnect' (RBXScriptConnection expected, got nil)", 2)
                end
                if self ~= conn then
                    lua_error("Expected ':' not '.' calling member function Disconnect", 2)
                end
                cstate.Connected = false
                cstate.Enabled = false
                local sig_key = runtime_get_id(sig) or sig
                local cl = runtime_signal_callbacks[sig_key] or (sig and runtime_signal_callbacks[sig])
                if cl then
                    for i = #cl, 1, -1 do
                        if cl[i].conn == conn then lua_table.remove(cl, i) break end
                    end
                end
            end, "Disconnect")
            cmt.__index = function(_, k)
                if k == "Disconnect" or k == "disconnect" then return dis end
                if k == "Connected" or k == "connected" then return cstate.Connected end
                if k == "Enabled" or k == "enabled" then return cstate.Enabled end
                if k == "Function" or k == "function" then return cstate.Function end
                if k == "Thread" or k == "thread" then return cstate.Thread end
                if k == "ForeignState" then return cstate.ForeignState end
                if k == "LuaConnection" then return cstate.LuaConnection end
                if k == "Fire" or k == "fire" then
                    return function(_, ...) return cstate.Function(...) end
                end
                if k == "Defer" or k == "defer" then
                    return function(_, ...) return cstate.Function(...) end
                end
                if k == "Disable" or k == "disable" then
                    return function() cstate.Enabled = false end
                end
                if k == "Enable" or k == "enable" then
                    return function() cstate.Enabled = true end
                end
                return nil
            end
            if sig ~= nil then
                local sig_key = runtime_get_id(sig) or sig
                local cl = runtime_signal_callbacks[sig_key] or runtime_signal_callbacks[sig]
                if not cl then cl = {} end
                runtime_signal_callbacks[sig_key] = cl
                runtime_signal_callbacks[sig] = cl
                cl[#cl + 1] = { fn = realfn, once = (once == true), conn = conn, cstate = cstate }
            end
            return conn
        end
