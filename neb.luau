                    local stop = k and (k + #closer - 1) or n
                    for p = i, stop do
                        if src:sub(p, p) == "\n" then line = line + 1 end
                    end
                    i = stop + 1
                else
                    local k = src:find("\n", i + 2, true)
                    if k then line = line + 1 end
                    i = k and (k + 1) or (n + 1)
                end
            else
                local k = src:find("\n", i + 2, true)
                if k then line = line + 1 end
                i = k and (k + 1) or (n + 1)
            end
