local function dumper_get_debug_id(p)
    if not dumper_at.debugIds[p] then
        dumper_at.debugIdCtr = dumper_at.debugIdCtr + 1
        local n = dumper_at.debugIdCtr
        dumper_at.debugIds[p] = tostring_function(n * 17 + 3) .. "-" .. tostring_function(n * 97 + 11)
    end
    return dumper_at.debugIds[p]
end

local function dumper_remove_child(parent, child)
    local list = parent and dumper_at.children[parent]
    if not list then return end
    for i = #list, 1, -1 do
        if list[i] == child then table.remove(list, i) end
    end
end

local function dumper_set_parent(child, parent)
    local oldParent = dumper_state.parent_map[child]
    if oldParent == parent then return end
    dumper_remove_child(oldParent, child)
    dumper_state.parent_map[child] = parent
    if parent then
        dumper_at.children[parent] = dumper_at.children[parent] or {}
        table.insert(dumper_at.children[parent], child)
    end
end

local function dumper_is_descendant_of(child, parent)
    local cur = dumper_state.parent_map[child]
    while cur do
        if cur == parent then return true end
        cur = dumper_state.parent_map[cur]
    end
    return false
end

local function dumper_get_all_descendants(root, out)
    out = out or {}
    for _, child in ipairs_function(dumper_at.children[root] or {}) do
        table.insert(out, child)
        dumper_get_all_descendants(child, out)
    end
    return out
end

local dumper_proxy_marker = {}
local function dumper_is_proxy_table(target)
    if type_function(target) ~= "table" then return false end
    local ok, result = pcall_function(function() return rawget(target, dumper_proxy_marker) == true end)
    return ok and result
end

local function dumper_get_proxy_value(target)
    if dumper_is_proxy_table(target) then
        return rawget(target, "__value") or 0
    end
    return 0
end

local function dumper_is_proxy(target)
    if type_function(target) ~= "table" then return false end
    local ok, result = pcall_function(function() return rawget(target, dumper_proxy_marker) == true end)
    return ok and result
end

local function dumper_get_proxy_id(target)
    if not dumper_is_proxy(target) then return nil end
    return rawget(target, "__proxy_id")
end

local function dumper_clean_escapes(content)
    return content:gsub("\\(.)", function(escapedChar)
        if escapedChar:match('[abfnrtv\\\'%"]') then
            return "" .. escapedChar
        end
        return escapedChar
    end)
end

local function dumper_strip_luau_syntax(rawCode)
    if not rawCode or rawCode == "" then return rawCode end
    rawCode = rawCode:gsub("\239\187\191", "")
    rawCode = rawCode:gsub("\r\n", "\n"):gsub("\r", "\n")
    return rawCode
end

local function dumper_process_string(inputString)
    if type_function(inputString) ~= "string" then return '"' end
    local outputParts = {}
    local currentIndex, totalLength = 1, #inputString
    return dumper_clean_escapes(inputString)
end

local _HOOKOP = {}
