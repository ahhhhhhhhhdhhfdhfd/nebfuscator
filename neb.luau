do
    local schema_files = { "api.json", "apidump.json", "envi/api.json", "envi/apidump.json", "env/api.json", "unveilr/env/api.json" }
    local script_dir = nil
    do
        local okDI, src = pcall(function() return debug.info(1, "s") end)
        if okDI and lua_type(src) == "string" and #src > 0 then
            src = src:gsub("^@", "")
            script_dir = src:match("^(.*)[/\\]")
        end
    end
    local candidates, seen = {}, {}
    local function add_candidate(path)
        if path and #path > 0 and not seen[path] then
            seen[path] = true
            candidates[#candidates + 1] = path
        end
    end
    if script_dir then
        local sep = script_dir:find("\\", 1, true) and "\\" or "/"
        for _, n in lua_ipairs(schema_files) do
            add_candidate(script_dir .. sep .. n)
        end
    end
    for _, n in lua_ipairs(schema_files) do
        add_candidate(n)
    end
    local found_files = {}
    for _, p in lua_ipairs(candidates) do
        local okF, exists = pcall(function() return fs and fs.isFile and fs.isFile(p) end)
        if okF and exists then
            found_files[#found_files + 1] = p
        end
    end
    init_api_schema = function()
        if api_classes then return true end
        if #found_files == 0 then
            return false
        end
        local loaded_any = false
        local loaded_names = {}
        for _, path in lua_ipairs(found_files) do
            local ok, raw = pcall(function() return fs.readFile(path) end)
            if ok and raw then
                local okD, data = pcall(function()
                    return serde_library and serde_library.decode and serde_library.decode("json", raw)
                end)
                if okD and data and (data.Classes or data.Enums) then
                    loaded_any = true
                    loaded_names[#loaded_names + 1] = path
                    if not api_classes then
                        api_classes = {}
                        class_inheritance = {}

                        api_classes.__tags = {}
                    end
                    for _, c in lua_ipairs(data.Classes or {}) do
                        local name = c.Name

                        if c ~= nil and name ~= nil and lua_type(c.Tags) == "table" then
                            local tset = {}
                            for _, t in lua_ipairs(c.Tags) do
                                if lua_type(t) == "string" then tset[t] = true end
                            end
                            api_classes.__tags[name] = tset
                        end
                        if name then
                            local cls = api_classes[name]
                            if not cls then
                                cls = { name = name, members = {}, superclass = c.Superclass }
                                api_classes[name] = cls
                                class_inheritance[name] = c.Superclass
                            elseif cls.superclass == nil and c.Superclass ~= nil then
                                cls.superclass = c.Superclass
                                class_inheritance[name] = c.Superclass
                            end
                            for _, m in lua_ipairs(c.Members or {}) do
                                if m.Name and cls.members[m.Name] == nil then
                                    local tags, readOnly, deprecated = nil, nil, nil
                                    local tags_raw = m.Tags
                                    if lua_type(tags_raw) == "table" then
                                        tags = {}
                                        if tags_raw[1] ~= nil then
                                            for _, t in lua_ipairs(tags_raw) do
                                                if lua_type(t) == "string" then
                                                    tags[t] = true
                                                elseif lua_type(t) == "table" and lua_type(t.PreferredDescriptorName) == "string" then
                                                    tags[t.PreferredDescriptorName] = true
                                                end
                                            end
                                        else
                                            for k, v in lua_pairs(tags_raw) do
                                                if lua_type(k) == "string" then tags[k] = v or true end
                                            end
                                        end
                                        readOnly = tags.ReadOnly
                                        deprecated = tags.Deprecated
                                    end
                                    cls.members[m.Name] = {
                                        kind = (m.MemberType or "Property"),
                                        valueType = m.ValueType and m.ValueType.Name or nil,
                                        category = m.ValueType and m.ValueType.Category or nil,
                                        tags = tags,
                                        readOnly = readOnly,
                                        deprecated = deprecated,
                                    }
                                end
                            end
                        end
                    end
                    if not api_enums then api_enums = {} end
                    for _, e in lua_ipairs(data.Enums or {}) do
                        if e.Name and not api_enums[e.Name] then
                            local items = {}
                            for _, it in lua_ipairs(e.Items or {}) do
                                if it.Name then items[it.Name] = it.Value or 0 end
                            end
                            api_enums[e.Name] = items
                        end
                    end
                end
            end
        end
        if loaded_any then
            local joined = table.concat(loaded_names, ", ")
            return true
        end
        return false
    end
    local okI = pcall(init_api_schema)
    if not okI or not api_classes then
        api_classes, api_enums, class_inheritance = nil, nil, nil
    end
end
local function find_class_member(className, memberName)
    if not api_classes or not className or not memberName then return nil end
    local cn = className
    local guard = 0
    while cn and guard < 64 do
        local c = api_classes[cn]
        if c and c.members and c.members[memberName] then
            return c.members[memberName]
        end
        cn = class_inheritance and class_inheritance[cn] or nil
        guard = guard + 1
    end
    return nil
end
local function schema_isa(className, superName)
    if not api_classes or not className then return nil end

    if className == superName then return true end
    local cn = className
    local guard = 0
    while cn and guard < 64 do
        if cn == superName then return true end
        cn = class_inheritance and class_inheritance[cn] or nil
        guard = guard + 1
    end
    return false
end
