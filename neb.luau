local WAD_MAX_STRINGS = 3000
local WAD_MAX_STRLEN = 500
local function wad_extract_prologue(src)
    if lua_type(src) ~= "string" then return nil end
    local _, he = src:find("return%(%s*function%s*%(%s*%.%.%.%s*%)", 1)
    if not he then return nil end
    local ts, te, tname = src:find("local%s+([%a_][%w_]*)%s*=%s*{", he)
    if not ts or te - he > 2000 then return nil end
    local vm_at = nil
    local from = 1
    while true do
        local s, e = src:find("return%s*%(%s*function%s*%(", from)
        if not s then break end
        vm_at = s
        from = e + 1
    end
    if not vm_at or vm_at <= te then return nil end
    do
        local pe = src:find("%)", vm_at + 16)
        if not pe or pe - vm_at > 600 then return nil end
        local _, ncomma = src:sub(vm_at, pe):gsub(",", "")
        if ncomma < 7 then return nil end
    end
    local tail = src:sub(-60)
    if not tail:find("end%)%s*%(%s*%.%.%.%s*%)%s*$") then return nil end
    local body = src:sub(he + 1, vm_at - 1)
    if #body < 300 or #body > #src * 0.95 then return nil end
    local first_entry = src:sub(te + 1, te + 40)
    if not (first_entry:find('^%s*"b') or first_entry:find('^%s*"x')
        or first_entry:find('^%s*"\\%d')) then
        return nil
    end
    return body, tname
end
local function wad_is_printable(s)
    if lua_type(s) ~= "string" or #s == 0 or #s > WAD_MAX_STRLEN then return false end
    local printable = 0
    for i = 1, #s do
        local b = lua_string.byte(s, i) or 0
        if (b >= 32 and b <= 126) or b == 10 or b == 13 or b == 9 then
            printable += 1
        end
    end
    if printable / #s >= 0.6 then return true end
    if s:find("://", 1, true) or s:find("Fire", 1, true) or s:find("Remote", 1, true) then
        return true
    end
    return false
end
local function run_wad_prologue(orig_code)
    local body, tname = wad_extract_prologue(orig_code)
    if not body then return false, nil, "no prologue" end
    local chunk = "do " .. body .. " return " .. tname .. " end"
    local fn
    if luau_runtime and lua_type(luau_runtime.compile) == "function" and lua_type(luau_runtime.load) == "function" then
        local okc, bc = lua_pcall(luau_runtime.compile, chunk)
        if not okc then return false, nil, "compile failed" end
        local penv = { string = lua_string, table = lua_table, math = lua_math,
            type = lua_type, ipairs = lua_ipairs, pairs = lua_pairs }
        penv._G = penv
        local okl, f = lua_pcall(luau_runtime.load, bc, { debugName = "wad-prologue", environment = penv })
        if not okl then return false, nil, "load failed" end
        fn = f
    elseif lua_type(loadstring) == "function" then
        local f = loadstring(chunk, "wad-prologue")
        if not f then return false, nil, "compile failed" end
        fn = f
    else
        return false, nil, "no compiler"
    end
    local okr, tbl = lua_pcall(fn)
    if not okr or lua_type(tbl) ~= "table" then
        return false, nil, "prologue error"
    end
    local okg, len = lua_pcall(function() return #tbl end)
    if not okg or lua_type(len) ~= "number" or len <= 0 or len > 20000 then
        return false, nil, "bad table"
    end
    local strs, n = {}, 0
    for i = 1, len do
        if n >= WAD_MAX_STRINGS then break end
        local okv, v = lua_pcall(function() return tbl[i] end)
        if okv and lua_type(v) == "string" and wad_is_printable(v) then
            n += 1
            strs[n] = v
        end
    end
    if n < 3 then return false, nil, "too few strings" end
    local parts = {}
    parts[#parts + 1] = "local _wad_strings = {"
    local acc = 0
    for i = 1, n do

        local line = "    " .. q(strs[i]) .. ","
        acc += #line
        if acc > 700000 then
            break
        end
        parts[#parts + 1] = line
    end
    parts[#parts + 1] = "}"
    parts[#parts + 1] = "return _wad_strings"
    return true, lua_table.concat(parts, "\n"), ("strings=%d"):format(n)
end
