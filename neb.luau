local host_emulator = {}
function host_emulator.delay(seconds, callback)
    if type(callback) ~= "function" then return nil end
    local thread = coroutine.create(function()
        if type(seconds) == "number" and seconds > 0 then
            local started = os.clock()
            while os.clock() - started < seconds do
                coroutine.yield()
            end
        end
        callback()
    end)
    coroutine.resume(thread)
    return thread
end
function host_emulator.tick()
    return os.clock()
end
function host_emulator.time()
    return os.time()
end
function host_emulator.version()
    return _VERSION or "Luau"
end
function host_emulator.secure_call(func, ...)
    local ok, result = pcall(func, ...)
    if ok then return result end
    return nil
end
host_emulator.task = {
    spawn = function(callback, ...)
        if type(callback) ~= "function" then return nil end
        local thread = coroutine.create(function() callback(...) end)
        coroutine.resume(thread)
        return thread
    end,
    defer = function(callback, ...)
        if type(callback) ~= "function" then return nil end
        local thread = coroutine.create(function() callback(...) end)
        coroutine.resume(thread)
        return thread
    end,
    delay = function(seconds, callback, ...)
        return host_emulator.delay(seconds, function() callback(...) end)
    end,
    wait = function(seconds)
        if type(seconds) == "number" and seconds > 0 then
            local started = os.clock()
            while os.clock() - started < seconds do
                coroutine.yield()
            end
        end
        return os.clock() - (started or 0)
    end
}


