local function scrub(s)
    if lua_type(s) ~= "string" then s = lua_tostring(s) end
    if #s <= 20000 then
        local urls = {}
        s = s:gsub("(https?://[%w_%-%.%?%#%=%%%+%/&~@!$'%(%)%*,:;]+)", function(u)
            urls[#urls + 1] = u
            return "\0URL_" .. #urls .. "\0"
        end)
        s = s:gsub("%f[%a][A-Za-z]:[\\/][^:\r\n]-([%w%._%-]+):%d+:?%s*", "")
        s = s:gsub("%f[%a][A-Za-z]:[\\/][^:\r\n]*:?%s*", "")
        s = s:gsub("/[a-zA-Z0-9_%.-]+/[^:\r\n]-([%w%._%-]+):%d+:?%s*", "")
        s = s:gsub("/[a-zA-Z0-9_%.-]+/[^:\r\n]*:?%s*", "")
        s = s:gsub("@lune/[%w_%.-]+", "script")
        s = s:gsub("[%w%.%-_]*lune[%w%.%-_]*", "luau")
        s = s:gsub("[%.\\]*[\\/]?neb[%w%.%-_]*:?%d*:?%s*", "")
        s = s:gsub("%.[\\/][%w%.%-_]+:%d+:?%s*", "")
        s = s:gsub("[%w%.%-_]+%.luau?:%d+:?%s*", "")
        s = s:gsub("^[-%s]*syntax error:%s*", "")
        s = s:gsub("^compile failed:%s*", "")
        s = s:gsub("^SyntaxError:%s*", "")
        s = s:gsub("^%s*error:%s*", "")
        if s:find("stack overflow", 1, true) and not s:find("Stack overflow", 1, true) then
            s = s:gsub("stack overflow", "Stack overflow")
        end
        s = s:gsub("%zURL_(%d+)%z", function(idx)
            return urls[lua_tonumber(idx)] or ""
        end)
    end
    local nl = s:find("\n", 1, true)
    if nl then s = s:sub(1, nl - 1) end
    return s:match("^%s*(.-)%s*$") or s
end
local function safewrite(filepath, content)
    if lua_type(content) ~= "string" then content = lua_tostring(content) end
    local ok = lua_pcall(fs.writeFile, filepath, content)
    if not ok and lua_type(io) == "table" and lua_type(io.open) == "function" then
        local f = io.open(filepath, "wb")
        if f then
            local wok = lua_pcall(f.write, f, content)
            lua_pcall(f.close, f)
            ok = wok
        end
    end
    return ok == true
end
local function readbin(path)
    local ok, data = lua_pcall(fs.readFile, path)
    if ok and lua_type(data) == "string" and #data > 0 then return data end
    if lua_type(io) == "table" and lua_type(io.open) == "function" then
        local f = io.open(path, "rb")
        if f then
            local rok, rdata = lua_pcall(f.read, f, "*a")
            lua_pcall(f.close, f)
            if rok and lua_type(rdata) == "string" and #rdata > 0 then return rdata end
        end
    end
    return nil
end
