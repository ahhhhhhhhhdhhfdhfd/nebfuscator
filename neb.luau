local function load_chunk(src, name, env)
    local target_env = env or active_senv
    local chunk_name = name or "script"
    local last_err = nil
    if runtime_state.cli_flags and runtime_state.cli_flags["dump_loads"] and lua_type(src) == "string" then
    end

    local function repin_intrinsics(te)
        if lua_type(te) ~= "table" then return end
        local pinned = runtime_state.pinned_intrinsics
        if not pinned then return end
        for k, v in lua_pairs(pinned) do
            if lua_type(v) == "function" or lua_type(v) == "table" then lua_rawset(te, k, v) end
        end
    end
    if luau_runtime and lua_type(luau_runtime.load) == "function" then
        local lok, fn = lua_pcall(luau_runtime.load, src, {
            debugName = chunk_name,
            environment = target_env,
            injectGlobals = false,
        })
        if lok and lua_type(fn) == "function" then
            repin_intrinsics(target_env)
            if host_setfenv then lua_pcall(host_setfenv, fn, target_env) end
            return fn
        elseif not lok then
            last_err = fn
        end
        if lua_type(luau_runtime.compile) == "function" then
            local cok, bc = lua_pcall(luau_runtime.compile, src, { optimizationLevel = 0, debugLevel = 1 })
            if cok and bc then
                local load_ok2, func2 = lua_pcall(luau_runtime.load, bc, {
                    debugName = chunk_name,
                    environment = target_env,
                    injectGlobals = false,
                })
                if load_ok2 and lua_type(func2) == "function" then
                    if host_setfenv then lua_pcall(host_setfenv, func2, target_env) end
                    return func2
                elseif not load_ok2 then
                    last_err = func2
                end
            else
                last_err = bc
            end
        end
    end
    if host_load_string and lua_type(host_load_string) == "function" then
        local ok, fn = lua_pcall(host_load_string, src, chunk_name, "t", target_env)
        if ok and lua_type(fn) == "function" then
            if host_setfenv then lua_pcall(host_setfenv, fn, target_env) end
            return fn
        elseif not ok then
            last_err = fn
        end
    end
    return nil, last_err or "No compiler available"
end
