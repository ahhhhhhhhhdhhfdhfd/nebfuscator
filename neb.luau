local change_watch_max = 2000000
local field_index = {}

_HOOKOP.CALL = function(fn, ...)
    if type(fn) == "function" then return fn(...) end
    if type(fn) == "table" then
        local mt = getmetatable(fn)
        if mt and mt.__call then return mt.__call(fn, ...) end
    end
    return nil
end
_HOOKOP.NAMECALL = _HOOKOP.CALL

_HOOKOP.CHECKIF = function(cond, ...) return cond end
_HOOKOP.checkifend = function(...) end

_HOOKOP.CHECKAND = function(a, bOrFn, isWrapped, ...)
    if not a then return a end
    if isWrapped and type(bOrFn) == "function" then
        local ok, v = pcall(bOrFn, ...); return ok and v or bOrFn
    end
    return bOrFn
end

_HOOKOP.CHECKOR = function(a, bOrFn, isWrapped, ...)
    if a then return a end
    if isWrapped and type(bOrFn) == "function" then
        local ok, v = pcall(bOrFn, ...); return ok and v or bOrFn
    end
    return bOrFn
end

_HOOKOP.CHECKEQ = function(a,b)
    local ok,r=pcall(function()return a==b end); return ok and r or false end
_HOOKOP.CHECKNEQ = function(a,b)
    local ok,r=pcall(function()return a~=b end); return ok and r or true end
_HOOKOP.COMPG = function(a,b)
    local ok,r=pcall(function()return a > b end); return ok and r or false end
_HOOKOP.COMPL = function(a,b)
    local ok,r=pcall(function()return a < b end); return ok and r or false end
_HOOKOP.COMPGE = function(a,b)
    local ok,r=pcall(function()return a >= b end); return ok and r or false end
_HOOKOP.COMPLE = function(a,b)
    local ok,r=pcall(function()return a <= b end); return ok and r or false end

_HOOKOP.CHECKLEN = function(a)
    local ok,r=pcall(function()return #a end); return ok and r or 0 end
_HOOKOP.CHECKUNM = function(a)
    local ok,r=pcall(function()return -a end); return ok and r or 0 end
_HOOKOP.CHECKNOT = function(a) return not a end

_HOOKOP.CONCAT = function(a,b)
    local ok,r=pcall(function()return tostring(a)..tostring(b) end)
    return ok and r or ""
end
_HOOKOP.CONSTRUCT = function(t) return t end

_HOOKOP.FORINFO = function(id,f,t,s)
    field_index[id] = {from=tonumber(f) or 0, to=tonumber(t) or 0, step=tonumber(s) or 1}
end
_HOOKOP.FORSTEP1 = function(id) return field_index[id] and field_index[id].from or 0 end
_HOOKOP.FORSTEP2 = function(id) return field_index[id] and field_index[id].to or 0 end
_HOOKOP.FORSTEP3 = function(id) return field_index[id] and field_index[id].step or 1 end

_HOOKOP.checkwhile = function(cond, id)
    if not cond then change_watch[id] = nil; return false end
    change_watch[id] = (change_watch[id] or 0) + 1
    if change_watch[id] >= change_watch_max then change_watch[id] = nil; return false end
    return cond
end
_HOOKOP.checkwhileend = function(id) change_watch[id] = nil end
_HOOKOP.CHECKWHILE = function(cond)
    change_watch[0] = (change_watch[0] or 0) + 1
    if change_watch[0] >= change_watch_max then change_watch[0] = nil; return false end
    return cond
end

_HOOKOP.TEMPLATE_STRING = function(fmt, ...)
    local args={...}; local i=0
    return (tostring(fmt) or ""):gsub("%%s", function()
        i=i+1; return tostring(args[i] or "")
    end)
end

_HOOKOP.CHECKINDEX = function(obj, key)
    if obj == nil then return nil end
    local ok,r = pcall(function() return obj[key] end)
    return ok and r or nil
end

_HOOKOP.__EQ = function(a,b) return a==b end
_HOOKOP.__NEQ = function(a,b) return a~=b end
_HOOKOP.hookexpr = function() end
_HOOKOP.hookeq = function() end

_HOOKOP.install = function(env)
    local set_value = (env == _G) and rawset or
                 (type(rawset) == "function" and rawset) or
                 function(t,k,v) t[k]=v end
    for k, v in pairs(_HOOKOP) do
        if type(k) == "string" and type(v) == "function"
           and k ~= "install" and k ~= "preamble" then
            set_value(env, k, v)
            if not k:match("^__") then
                set_value(env, "CODER_" .. k, v)
            end
        end
    end
end

