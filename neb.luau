local function repair_syntax_iterative(source, max_attempts)
    max_attempts = max_attempts or 200
    local lines = {}
    for line in (source .. "\n"):gmatch("([^\r\n]*)\r?\n") do
        table.insert(lines, line)
    end
    local attempts = 0
    while attempts < max_attempts do
        attempts = attempts + 1
        local code_str = table.concat(lines, "\n")
        local ok, err = luau_runtime and pcall(luau_runtime.compile, code_str) or pcall(loadstring, code_str)
        if ok and (type(err) ~= "string" or not err:find("syntax error")) then
            return code_str, attempts - 1
        end
        local line_no = tonumber(tostring(err):match(":(%d+):"))
        if not line_no or not lines[line_no] or lines[line_no]:sub(1, 4) == "-- [" then
            break
        end
        lines[line_no] = "-- [syntax-repair] " .. lines[line_no]
    end
    return table.concat(lines, "\n"), attempts
end
local neb_ui_cb_depth = 0
local function auto_trigger_ui_callback(method_name, config_tbl)
    if lua_type(config_tbl) ~= "table" then return end
    if neb_ui_cb_depth > 4 then return end
    local cb = config_tbl.Callback or config_tbl.callback or config_tbl.func
    if lua_type(cb) ~= "function" then return end
    local name = tostring(method_name):lower()
    local dummy_arg = nil
    if name:find("toggle") or name:find("checkbox") then
        dummy_arg = true
    elseif name:find("slider") or name:find("range") then
        dummy_arg = config_tbl.Default or config_tbl.default or 50
    elseif name:find("dropdown") or name:find("list") then
        local opts = config_tbl.Options or config_tbl.options or {"Default"}
        dummy_arg = opts[1] or "Option"
    elseif name:find("textbox") or name:find("input") then
        dummy_arg = config_tbl.Default or "TestInput"
    elseif name:find("keybind") or name:find("bind") then
        dummy_arg = { Name = "E", Value = 69 }
    end
    neb_ui_cb_depth = neb_ui_cb_depth + 1
    lua_pcall(cb, dummy_arg)
    neb_ui_cb_depth = neb_ui_cb_depth - 1
end
