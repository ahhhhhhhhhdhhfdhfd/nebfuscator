runtime_state.strip_comments = function(text)
    if lua_type(text) ~= "string" or text == "" then return text end
    local n = #text
    local buf, i = {}, 1
    while i <= n do
        local c = text:sub(i, i)
        if c == "-" and text:sub(i + 1, i + 1) == "-" then
            local eq = text:match("^%-%-%[(=*)%[", i)
            if eq ~= nil then
                local closer = "]" .. eq .. "]"
                local s, e = text:find(closer, i + 3 + #eq, true)
                if s == nil then
                    break
                end
                local span = text:sub(i, e)
                local _, nl = span:gsub("\n", "")
                for _ = 1, nl do buf[#buf + 1] = "\n" end
                i = e + 1
            else
                local e = text:find("\n", i, true)
                if e == nil then
                    break
                end
                buf[#buf + 1] = "\n"
                i = e + 1
            end
        elseif c == '"' or c == "'" then
            local j = i + 1
            while j <= n do
                local d = text:sub(j, j)
                if d == "\\" then
                    j = j + 2
                elseif d == c then
                    j = j + 1
                    break
                elseif d == "\n" then
                    break
                else
                    j = j + 1
                end
            end
            buf[#buf + 1] = text:sub(i, j - 1)
            i = j
        elseif c == "[" then
            local eq = text:match("^%[(=*)%[", i)
            if eq ~= nil then
                local closer = "]" .. eq .. "]"
                local s, e = text:find(closer, i + 2 + #eq, true)
                if s == nil then
                    buf[#buf + 1] = text:sub(i)
                    break
                end
                buf[#buf + 1] = text:sub(i, e)
                i = e + 1
            else
                buf[#buf + 1] = c
                i = i + 1
            end
        else
            buf[#buf + 1] = c
            i = i + 1
        end
    end
    return lua_table.concat(buf)
end
