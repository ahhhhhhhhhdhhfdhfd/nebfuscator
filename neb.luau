    local function runtime_product_info(id, infoType)
        local kind = "asset"
        if lua_type(infoType) == "table" then
            local nm = lua_rawget(infoType, "Name")
            if lua_type(nm) == "string" and nm ~= "" then kind = nm:lower() end
        elseif infoType ~= nil then
            lua_error("bad argument #3 to 'GetProductInfo' (Enum.InfoType expected)", 3)
        end
        local url
        if kind == "game" then
            url = "https://games.roblox.com/v1/games/multiget-place-details?universeIds=" .. lua_tostring(id)
        elseif kind == "user" then
            url = "https://users.roblox.com/v1/users/" .. lua_tostring(id)
        elseif kind == "asset" then
            url = "https://economy.roblox.com/v2/assets/" .. lua_tostring(id) .. "/details"
        else
            lua_error("Unsupported info type " .. kind, 3)
        end
        local body = runtime_do_http(url)
        if lua_type(body) ~= "string" or #body == 0 then
            lua_error(("Unable to fetch info for id %s"):format(lua_tostring(id)), 0)
        end
        local okd, data = lua_pcall(function() return runtime_state.http_service:JSONDecode(body) end)
        if not okd or lua_type(data) ~= "table" then
            lua_error(("Unable to fetch info for id %s"):format(lua_tostring(id)), 0)
        end
