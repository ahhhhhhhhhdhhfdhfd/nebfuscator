            if neb_permissive then return Enum_obj end
            lua_error("attempt to call a userdata value", 2)
        end)
        mt.__index = function(_, tname)
            if tname == "GetEnums" then
                return mark_c(function()
                    for name in lua_pairs(valid_enums) do
                        if not enum_types[name] then
                            enum_types[name] = make_enum_type(name)
                        end
                    end
                    local res = {}
                    for _, et in lua_pairs(enum_types) do res[#res + 1] = et end
                    return res
                end, "GetEnums")
            end
            if lua_type(tname) ~= "string" or tname:find("^__") then return nil end
            if not valid_enums[tname] and not (api_enums and api_enums[tname]) and not neb_permissive then
                lua_error(tname .. " is not a valid Enum", 2)
            end
            if enum_types[tname] then return enum_types[tname] end
            local et = make_enum_type(tname)
            enum_types[tname] = et
            return et
        end
        do
            local old_mt = lua_getmetatable(et)
            if old_mt then
                local old_index = old_mt.__index
                old_mt.__index = function(self, k)
                    if api_enums then
                        local items = api_enums[k]
                        if items then return make_enum_type(k) end
                    end
                    if old_index then return old_index(self, k) end
                    return nil
                end
            end
        end
        neb_rawmts[Enum_obj] = mt
    end
