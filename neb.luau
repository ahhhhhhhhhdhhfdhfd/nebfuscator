        local call_ok0, param0 = lua_pcall(function() return weld.Part0 end)
        local call_ok1, param1 = lua_pcall(function() return weld.Part1 end)
        local function same(a, b)
            if a == nil or b == nil then return false end
            if lua_rawequal(a, b) then return true end
            return runtime_is_instance(a) and runtime_is_instance(b) and runtime_get_id(a) == runtime_get_id(b)
        end
        if same(param0, node) and param1 ~= nil then return param1 end
        if same(param1, node) and param0 ~= nil then return param0 end
        return nil
