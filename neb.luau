    if #runtime_state.netcalls > 0 then
        L[#L + 1] = "-- network"
        local seen = {}
        for _, c in lua_ipairs(runtime_state.netcalls) do
            if not seen[c.url] then
                seen[c.url] = true
                L[#L + 1] = "--   " .. c.method .. " " .. c.url
            end
        end
    end
    if #runtime_state.cap_strings > 0 then
        L[#L + 1] = ("-- captured %d runtime string(s)"):format(#runtime_state.cap_strings)
        for i = 1, lua_math.min(#runtime_state.cap_strings, 12) do
            local rec = runtime_state.cap_strings[i]
            local one = (rec.s:gsub("\n", "\\n"):gsub("\r", "\\r"))
            if #one > 110 then one = one:sub(1, 110) .. "..." end
            L[#L + 1] = ("--   [%s] %s"):format(rec.origin, one)
        end
    end
    if #runtime_state.bypassed_traps > 0 then
        L[#L + 1] = "-- anti-tamper"
        for _, note in lua_ipairs(runtime_state.bypassed_traps) do
