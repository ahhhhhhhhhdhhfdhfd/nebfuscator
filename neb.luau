function neb_ext.hercules_probe(src)
    if lua_type(src) ~= "string" or #src < 500 then return nil end
    local n = #src
    local i = 1
    local charset, charset_at = nil, nil
    local guard = 0
    while i <= n do
        guard += 1
        if guard > 40000 then break end
        local ch = src:sub(i, i)
        if ch == '"' or ch == "'" then
            local epos, bytes = neb_ext.parse_quoted(src, i)
            if not epos then break end
            if not charset and bytes and #bytes == 94 then
                local seen = {}
                local ok = true
                for _, b in lua_ipairs(bytes) do
                    if b < 1 or b > 94 or seen[b] then
                        ok = false
                        break
                    end
                    seen[b] = true
                end
                if ok then
                    charset = {}
                    for _, b in lua_ipairs(bytes) do charset[b] = true end
                    charset_at = i
                end
            end
            i = epos
        else
            i += 1
        end
    end
    if not charset then return nil end
    local best, count = 0, 0
    i = 1
    guard = 0
    while i <= charset_at do
        guard += 1
        if guard > 40000 then break end
        local ch = src:sub(i, i)
        if ch == '"' or ch == "'" then
            local epos, bytes = neb_ext.parse_quoted(src, i)
            if not epos then break end
            if bytes and #bytes > 256 then
                local ok = true
                for _, b in lua_ipairs(bytes) do
                    if b ~= 95 and not charset[b] then
                        ok = false
                        break
                    end
                end
                if ok then
                    count += 1
                    if #bytes > best then best = #bytes end
                end
            end
            i = epos
        else
            i += 1
        end
    end
    if count == 0 then return nil end
    return { charset_at = charset_at, payload_len = best, payload_count = count }
end
