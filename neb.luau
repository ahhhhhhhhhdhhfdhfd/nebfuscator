    local function to_float32(n)
        n = lua_tonumber(n) or 0
        buffer.writef32(float32_buffer, 0, n)
        return buffer.readf32(float32_buffer, 0)
    end

    runtime_state.to_float32 = to_float32
    local function to_int32(n)
        n = lua_tonumber(n) or 0
        if n ~= n or n == lua_math.huge or n == -lua_math.huge then n = 0 end
        n = (n >= 0) and lua_math.floor(n) or lua_math.ceil(n)
        n = n % 4294967296
        if n >= 2147483648 then n = n - 4294967296 end
        return n
    end

    local function float32_to_string(n)

        if n ~= n then return "nan" end
        if n == lua_math.huge then return "inf" end
        if n == -lua_math.huge then return "-inf" end
        if n == lua_math.floor(n) then return lua_tostring(lua_math.floor(n)) end
        local w = to_float32(n)
        if w == lua_math.floor(w) then return lua_tostring(lua_math.floor(w)) end

        for prec = 14, 17 do
            local s = lua_string.format("%." .. prec .. "g", w)
            if lua_tonumber(s) == w then return s end
        end
        return lua_string.format("%.17g", w)
    end

    local function color_component_to_string(n)
        if n ~= n then return "nan" end
        if n == lua_math.huge then return "inf" end
        if n == -lua_math.huge then return "-inf" end
        local w = to_float32(n)
        if w == lua_math.floor(w) then return lua_tostring(lua_math.floor(w)) end
        return lua_string.format("%g", w)
    end
