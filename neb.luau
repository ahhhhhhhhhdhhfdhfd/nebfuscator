local fs
do
    local ok, m = pcall(require, "@lune/fs")
    if not ok then
        ok, m = pcall(require, "@lute/fs")
        assert(ok, "fs library unavailable: " .. tostring(m))
        local L = m
        local w = {}
        for k, v in pairs(L) do w[k] = v end

        w.readFile = function(path)
            local runtime_state = L.stat and L.stat(path)
            if not runtime_state then return nil, "ENOENT: no such file", 2 end
            local h = L.open(path, "r")
            if not h then return nil, "EACCES: permission denied", 13 end
            local buf = buffer.create(runtime_state.size or 0)
            local n = L.readIntoBuffer(h, buf, 0, runtime_state.size or 0)
            L.close(h)
            return buffer.tostring(buf, 0, n or 0)
        end
        w.writeFile = function(path, data)
            local h = L.open(path, "w")
            if not h then return false, "EACCES: permission denied" end
            L.write(h, data)
            L.close(h)
            return true
        end
        w.readDir = function(path)
            local list = L.listdir(path)
            if type(list) ~= "table" then return nil, "ENOENT" end
            local out = {}
            for i = 1, #list do
                local e = list[i]
                if type(e) == "table" then out[i] = { name = e.name, type = e.type }
                else out[i] = { name = tostring(e), type = "file" } end
            end
            return out
        end
        m = w
    end
    fs = m
end
