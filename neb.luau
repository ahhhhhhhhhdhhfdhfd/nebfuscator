local function env_evaluate_probe(probe_name, weight)
    env_state.tamper_score = env_state.tamper_score + weight
    table.insert(env_state.tamper_events, {
        probe = probe_name,
        weight = weight,
        score = env_state.tamper_score,
    })
    if env_state.tamper_score >= env_configuration.tamper_threshold then
        return true
    end
    return false
end

local function env_probe_cframe(cf)
    if not env_configuration.cframe_probe_enabled then return end
    env_cframe_probe.check_count = env_cframe_probe.check_count + 1
    local ok = pcall(function()
        local _ = cf.X + cf.Y + cf.Z
    end)
    if not ok then
        env_cframe_probe.fail_count = env_cframe_probe.fail_count + 1
        env_evaluate_probe("cframe_mismatch", env_probe_weights.cframe_mismatch)
    end
end

local function env_probe_vector3(v3)
    if not env_configuration.vector3_probe_enabled then return end
    env_vector3_probe.check_count = env_vector3_probe.check_count + 1
    local ok = pcall(function()
        local _ = v3.X + v3.Y + v3.Z
    end)
    if not ok then
        env_vector3_probe.fail_count = env_vector3_probe.fail_count + 1
        env_evaluate_probe("vector3_mismatch", env_probe_weights.vector3_mismatch)
    end
end

local function env_probe_random(value)
    if not env_configuration.random_probe_enabled then return end
    env_random_probe.check_count = env_random_probe.check_count + 1
    if type(value) ~= "number" then
        env_random_probe.fail_count = env_random_probe.fail_count + 1
        env_evaluate_probe("random_tamper", env_probe_weights.random_tamper)
    end
end

