        table.sort(urls, function(a, b)
            if a.hint ~= b.hint then return a.hint < b.hint end
            return a.url < b.url
        end)
        L[#L + 1] = "-- links"
        for _, r in lua_ipairs(urls) do
            L[#L + 1] = ("--   %s%s  (x%d)"):format(r.hint == "url" and "" or ("[" .. r.hint .. "] "), r.url, r.n)
        end
    end
    for _, e in lua_pairs(runtime_state.callgraph) do edges[#edges + 1] = e end
